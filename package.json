{
  "name": "@goalsplit/runtime",
  "version": "0.1.0",
  "description": "可嵌入的动态 DAG 运行时、SQLite 持久化与 React 可视化面板",
  "type": "module",
  "engines": { "node": ">=24.13.0" },
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" },
    "./sqlite": { "types": "./dist/src/sqlite.d.ts", "import": "./dist/src/sqlite.js" },
    "./http": { "types": "./dist/src/http.d.ts", "import": "./dist/src/http.js" },
    "./testing": { "types": "./dist/src/testing.d.ts", "import": "./dist/src/testing.js" },
    "./react": { "types": "./dist/web/RuntimePanel.d.ts", "import": "./dist/web/RuntimePanel.js" },
    "./react/style.css": "./web/style.css"
  },
  "files": ["dist", "web/style.css", "README.md"],
  "scripts": {
    "dev": "tsx demo/server.ts --dev",
    "start": "tsx demo/server.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@xyflow/react": "^12.9.3",
    "express": "^5.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  }
}
